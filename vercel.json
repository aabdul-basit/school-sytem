{
  "rewrites": [
    {
      "source": "/",
      "destination": "/frontend/html/home.html"
    },
    {
      "source": "/courses.html",
      "destination": "/frontend/html/courses.html"
    },
    {
      "source": "/css/(.*)",
      "destination": "/frontend/css/$1"
    },
    {
      "source": "/js/(.*)",
      "destination": "/frontend/js/$1"
    }
  ]
}